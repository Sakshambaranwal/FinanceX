# ==============================================================================
# FinanceApp Environment Template (Copy to .env and fill in real secrets)
# ==============================================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/finance_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Shared JWT Secret Key (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_key_here

# Google OAuth 2.0 Credentials (Create as "Web Application" in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Microservices Ports & URLs
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
EXPENSE_SERVICE_PORT=8082
P2P_SERVICE_PORT=8084
CREDITCARD_SERVICE_PORT=8086
FRONTEND_PORT=5173

# Frontend Gateway Target (empty defaults to relative proxying)
VITE_GATEWAY_URL=

# Default Application Preferences
DEFAULT_CURRENCY=INR
VITE_DEFAULT_CURRENCY=INR
