# ==============================================================================
# FinanceApp Environment Template (Copy to .env and fill in real secrets)
# ==============================================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/saksham
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Shared JWT Secret Key (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_key_here

